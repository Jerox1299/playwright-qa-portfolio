{
  "compilerOptions": {
    /* Modern Node runtime target: Playwright transpiles TS itself, tsc is used for type safety only. */
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    /* Strictness: the point of using TypeScript in a test framework is catching contract drift early. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* tsc never emits: Playwright is the only runtime. `npm run typecheck` is a pure gate. */
    "noEmit": true,

    /* Path aliases keep imports stable when the POM layer grows (Playwright honours these natively). */
    "paths": {
      "@pages/*": ["./pages/*"],
      "@data/*": ["./data/*"]
    }
  },
  "include": ["pages/**/*.ts", "tests/**/*.ts", "data/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "playwright-report", "test-results"]
}
