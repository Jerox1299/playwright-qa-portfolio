{
  "name": "playwright-qa-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Senior QA Automation portfolio: Playwright + TypeScript E2E and API tests, SQL data validation, k6 performance and GitHub Actions CI.",
  "keywords": [
    "playwright",
    "typescript",
    "qa-automation",
    "sdet",
    "e2e-testing",
    "api-testing",
    "page-object-model",
    "k6",
    "ci-cd"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --headed --project=chromium",
    "test:debug": "playwright test --debug --project=chromium",
    "test:chromium": "playwright test --project=chromium",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://www.saucedemo.com",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
